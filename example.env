# ╔══════════════════════════════════════════════════════════════╗
# ║  OHM — Example Environment Configuration                     ║
# ║  Copy this file to .env and fill in your values              ║
# ╚══════════════════════════════════════════════════════════════╝

# ──────────────────────────────────────────────────────────────
# API Keys (set only the providers you use)
# ──────────────────────────────────────────────────────────────

# Anthropic (Claude)
# Get key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI (GPT-4o, etc.)
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Amazon Bedrock (uses AWS credentials, not a single key)
# Configure via: aws configure
# Or set these env vars:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_DEFAULT_REGION=us-east-1

# Ollama (local, no key needed — just set host if non-default)
OLLAMA_HOST=http://localhost:11434

# ──────────────────────────────────────────────────────────────
# OHM Defaults (override config.yaml values)
# ──────────────────────────────────────────────────────────────

# Default provider: anthropic | openai | gemini | bedrock | ollama
OHM_PROVIDER=anthropic

# Default model (provider-specific)
# Anthropic:  claude-sonnet-4-6, claude-sonnet-4-20250514, claude-3-opus-20240229
# OpenAI:     gpt-4o, gpt-4o-mini, gpt-4-turbo
# Gemini:     gemini-2.5-flash, gemini-2.5-pro, gemini-2.0-flash
# Bedrock:    global.anthropic.claude-sonnet-4-6
# Ollama:     llama3.2, mistral, codellama
OHM_MODEL=claude-sonnet-4-6

# Token generation limit
OHM_MAX_TOKENS=4096

# Temperature (0.0 = deterministic, 1.0 = creative)
OHM_TEMPERATURE=0.7

# Sandbox mode (true = tools run in sandbox, false = direct execution)
OHM_SANDBOX=true

# Log level: DEBUG | INFO | WARNING | ERROR
OHM_LOG_LEVEL=INFO

# ──────────────────────────────────────────────────────────────
# Tool Consent
# ──────────────────────────────────────────────────────────────

# Set to true to bypass tool confirmation prompts
# (useful for CI/CD, automated workflows)
# BYPASS_TOOL_CONSENT=false
